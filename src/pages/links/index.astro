---
import "@/styles/prose.css";

import Layout from "@/layouts/Layout.astro";
import Section from "@/layouts/Section.astro";
import { getLinks, renderCollection } from "@/lib/collection";

const l = await getLinks("summary");
const links = await renderCollection(l);
---

<Layout title="链接">
  <Section title="链接">
    <ul class="space-y-16 mb-16">
      {
        links.map(({ slug, title, url, type, createdAt, Content }) => (
          <li>
            <article class="prose">
              <h1 class="pb-0 border-b-0 text-base">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-bold underline underline-offset-4"
                >
                  {title}
                </a>
              </h1>
              <Content />
            </article>
            <div class="flex items-center gap-4 text-gray-500 text-xs ">
              <a href={`/links/${slug}`}>
                <time
                  datetime={createdAt}
                  class="tabular-nums underline underline-offset-2"
                >
                  {createdAt}
                </time>
              </a>
              <span>#{type}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
