---
import "@/styles/prose.css";

import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Section from "@/layouts/Section.astro";

const getDataFromEntryFilename = (filename: string) => {
  // filename is somethings like: "YYYY-MM-DD-xxx-xxx.md"
  const createdAt = filename.slice(0, 10); // "YYYY-MM-DD".length
  const slug = filename.slice(11); // "YYYY-MM-DD-".length
  return { createdAt, slug };
};

const getItems = async () => {
  const cols = await getCollection("notes");
  const items = await Promise.all(
    cols.map(async (col) => {
      const { createdAt, slug } = getDataFromEntryFilename(col.id);
      const { Content } = await render(col);
      return { Content, createdAt, slug };
    }),
  );

  return items.toSorted((a, b) => b.createdAt.localeCompare(a.createdAt));
};

const notes = await getItems();
---

<Layout title="笔记">
  <Section title="笔记">
    <ul class="space-y-16 mb-16">
      {
        notes.map(({ Content, createdAt, slug }) => (
          <li>
            <div class="mb-6 flex items-center gap-4 text-gray-500 text-xs">
              <a href={`/notes/${slug}`}>
                <time
                  datetime={createdAt}
                  class="tabular-nums underline underline-offset-2"
                >
                  {createdAt}
                </time>
              </a>
            </div>
            <article class="prose">
              <Content />
            </article>
          </li>
        ))
      }
    </ul>
  </Section>
</Layout>
