---
import "@/styles/prose.css";

import Demo from "@/components/Demo.astro";
import Layout from "@/layouts/Layout.astro";
import { getNotes, renderCollection } from "@/lib/collection";

const n = await getNotes();
const notes = await renderCollection(n);
---

<Layout title="笔记">
  <section class="space-y-12">
    <h2 class="font-bold text-2xl">笔记</h2>
    <ul class="space-y-16">
      {
        notes.map(({ title, demoUrl, createdAt, Content }) => (
          <li>
            <time
              datetime={createdAt}
              class="text-gray-500 text-xs tabular-nums"
            >
              {createdAt}
            </time>
            <article class="space-y-6 mt-4">
              {title && <h1 class="font-bold">{title}</h1>}
              {demoUrl && <Demo src={demoUrl} />}
              <div class="prose">
                <Content />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
